{
  "name": "local-vision-pipeline",
  "version": "0.1.0",
  "description": "OCR + UI/Face Detection + PII Fusion pipeline for the privacy-preserving browser agent (nishant branch)",
  "main": "src/api/analyzeScreen.ts",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json",
    "bench": "node --loader ts-node/esm src/bench/benchmark.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "onnxruntime-web": "^1.29.0",
    "vitest": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^26.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "vite": "^8.2.2"
  },
  "vitest": {
    "environment": "jsdom",
    "include": [
      "src/**/*.test.ts"
    ]
  }
}
